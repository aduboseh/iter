{
  "$id": "https://iter.dev/schemas/v1/decision_packet.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "ContractProvenance": {
      "additionalProperties": false,
      "description": "Compile-time SCG contract provenance exported by build.rs.",
      "properties": {
        "bridge_contract_rs_sha256": {
          "description": "SHA-256 of vendored contract.rs.",
          "type": "string"
        },
        "bridge_errors_rs_sha256": {
          "description": "SHA-256 of vendored errors.rs.",
          "type": "string"
        },
        "bridge_lib_rs_sha256": {
          "description": "SHA-256 of vendored lib.rs.",
          "type": "string"
        },
        "bridge_trace_rs_sha256": {
          "description": "SHA-256 of vendored trace.rs.",
          "type": "string"
        },
        "canonical_vectors_sha256": {
          "description": "Raw-byte SHA-256 of CANONICAL_VECTORS.json.",
          "type": "string"
        },
        "canonicalization_rule": {
          "description": "Canonicalization rule bound to the vendored contract.",
          "type": "string"
        },
        "contract_version": {
          "description": "SCG governance bridge contract version.",
          "type": "string"
        },
        "scg_source_commit": {
          "description": "Exact SCG source commit used as the vendored bridge origin.",
          "type": "string"
        },
        "scg_vendor_master_head": {
          "description": "SCG master head that had accepted the vendored bridge at vendor time.",
          "type": "string"
        }
      },
      "required": [
        "bridge_contract_rs_sha256",
        "bridge_errors_rs_sha256",
        "bridge_lib_rs_sha256",
        "bridge_trace_rs_sha256",
        "canonical_vectors_sha256",
        "canonicalization_rule",
        "contract_version",
        "scg_source_commit",
        "scg_vendor_master_head"
      ],
      "type": "object"
    },
    "EnergyEnvelope": {
      "additionalProperties": false,
      "description": "Energy envelope - thermodynamic state summary.\n\n# Fields All energy values are non-negative. Integrity in [0.0, 1.0].",
      "properties": {
        "integrity": {
          "description": "System integrity ratio [0.0, 1.0]",
          "pattern": "^[0-9a-f]{16}$",
          "type": "string"
        },
        "nodes": {
          "description": "Total energy across all nodes",
          "pattern": "^[0-9a-f]{16}$",
          "type": "string"
        },
        "reservoir": {
          "description": "Energy in reservoir",
          "pattern": "^[0-9a-f]{16}$",
          "type": "string"
        }
      },
      "required": [
        "integrity",
        "nodes",
        "reservoir"
      ],
      "type": "object"
    },
    "LearningEnvelope": {
      "additionalProperties": false,
      "description": "Learning envelope - capsule state and update audit.\n\n# Fields - capsule_id: Unique capsule identifier - epoch: Update count - version_hash: SHA-256 of capsule state (hex-encoded) - update_cost/paid/quality: Economics - status: Outcome of learning tick - scarcity_streak: Consecutive scarcity rejections",
      "properties": {
        "capsule_id": {
          "description": "Capsule identifier",
          "type": "string"
        },
        "epoch": {
          "description": "Current epoch (update count)",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "scarcity_streak": {
          "description": "Consecutive scarcity rejections",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "status": {
          "allOf": [
            {
              "$ref": "#/definitions/LearningStatus"
            }
          ],
          "description": "Outcome of learning tick"
        },
        "update_cost": {
          "description": "Cost of proposed update",
          "pattern": "^[0-9a-f]{16}$",
          "type": "string"
        },
        "update_paid": {
          "description": "Amount actually paid",
          "pattern": "^[0-9a-f]{16}$",
          "type": "string"
        },
        "update_quality": {
          "description": "Payment quality (paid / cost)",
          "pattern": "^[0-9a-f]{16}$",
          "type": "string"
        },
        "version_hash": {
          "description": "SHA-256 hash of capsule state (hex-encoded, 64 chars)",
          "type": "string"
        }
      },
      "required": [
        "capsule_id",
        "epoch",
        "scarcity_streak",
        "status",
        "update_cost",
        "update_paid",
        "update_quality",
        "version_hash"
      ],
      "type": "object"
    },
    "LearningStatus": {
      "description": "Learning update status - closed enum per SCG-INT-04.\n\nUnknown values fail closed.",
      "oneOf": [
        {
          "description": "Update was successfully committed",
          "enum": [
            "COMMITTED"
          ],
          "type": "string"
        },
        {
          "description": "No proposal generated (value delta below threshold)",
          "enum": [
            "NO_PROPOSAL_NO_DELTA"
          ],
          "type": "string"
        },
        {
          "description": "Rejected: cortex input quality below threshold",
          "enum": [
            "REJECTED_INPUT_QUALITY"
          ],
          "type": "string"
        },
        {
          "description": "Rejected: insufficient energy to fund update",
          "enum": [
            "REJECTED_SCARCITY"
          ],
          "type": "string"
        },
        {
          "description": "Rejected: hash verification or arithmetic error",
          "enum": [
            "REJECTED_INTEGRITY"
          ],
          "type": "string"
        }
      ]
    },
    "PolicyDecision": {
      "description": "Policy decision - closed enum.",
      "oneOf": [
        {
          "description": "Action is allowed",
          "enum": [
            "ALLOW"
          ],
          "type": "string"
        },
        {
          "description": "Action is denied",
          "enum": [
            "DENY"
          ],
          "type": "string"
        },
        {
          "description": "Learning is frozen",
          "enum": [
            "FREEZE_LEARNING"
          ],
          "type": "string"
        },
        {
          "description": "Degraded mode (quality below threshold)",
          "enum": [
            "DEGRADED_MODE"
          ],
          "type": "string"
        },
        {
          "description": "Requires external review",
          "enum": [
            "REQUIRE_REVIEW"
          ],
          "type": "string"
        }
      ]
    },
    "PolicyEnvelope": {
      "additionalProperties": false,
      "description": "Policy envelope - governance decision with audit trail.",
      "properties": {
        "decision": {
          "allOf": [
            {
              "$ref": "#/definitions/PolicyDecision"
            }
          ],
          "description": "Final decision"
        },
        "policy_hash": {
          "description": "SHA-256 hash of policy configuration (hex-encoded)",
          "type": "string"
        },
        "reason_codes": {
          "description": "Reason codes for decision (ordered)",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "decision",
        "policy_hash",
        "reason_codes"
      ],
      "type": "object"
    },
    "ProvenanceSource": {
      "additionalProperties": false,
      "description": "Provenance source declarations for static and dynamic proof-packet values.",
      "properties": {
        "canonical_vector_integrity": {
          "description": "Integrity validation method for the canonical vector file.",
          "type": "string"
        },
        "contract_values": {
          "description": "Source of static contract and bridge values.",
          "type": "string"
        },
        "decision_values": {
          "description": "Source of decision-specific values.",
          "type": "string"
        },
        "numeric_encoding": {
          "description": "Exact encoding used for proof-critical numeric packet fields.",
          "type": "string"
        },
        "vector_digest_casing": {
          "description": "Validation method for canonical vector digest casing.",
          "type": "string"
        }
      },
      "required": [
        "canonical_vector_integrity",
        "contract_values",
        "decision_values",
        "numeric_encoding",
        "vector_digest_casing"
      ],
      "type": "object"
    },
    "ReasoningEnvelope": {
      "additionalProperties": false,
      "description": "Reasoning envelope - cortex output summary.\n\n# Fields All signals in [0.0, 1.0].",
      "properties": {
        "conflict_signal": {
          "description": "Conflict detection signal [0.0, 1.0]",
          "pattern": "^[0-9a-f]{16}$",
          "type": "string"
        },
        "control_signal": {
          "description": "Control signal [0.0, 1.0]",
          "pattern": "^[0-9a-f]{16}$",
          "type": "string"
        },
        "quality": {
          "description": "Reasoning quality [0.0, 1.0] - payment ratio",
          "pattern": "^[0-9a-f]{16}$",
          "type": "string"
        },
        "value_signal": {
          "description": "Value signal from cortex [0.0, 1.0]",
          "pattern": "^[0-9a-f]{16}$",
          "type": "string"
        }
      },
      "required": [
        "conflict_signal",
        "control_signal",
        "quality",
        "value_signal"
      ],
      "type": "object"
    },
    "ReplayScope": {
      "additionalProperties": false,
      "description": "Replay scope bound into each proof packet.",
      "properties": {
        "cross_platform_replay_claimed": {
          "description": "Whether this packet claims cross-platform replay equivalence.",
          "type": "boolean"
        },
        "platform": {
          "description": "Target triple used to build the producing Iter binary.",
          "type": "string"
        },
        "replay_scope": {
          "description": "Replay guarantee scope for this packet.",
          "type": "string"
        },
        "rustc_version": {
          "description": "rustc version used to build the producing Iter binary.",
          "type": "string"
        }
      },
      "required": [
        "cross_platform_replay_claimed",
        "platform",
        "replay_scope",
        "rustc_version"
      ],
      "type": "object"
    }
  },
  "description": "Decision packet - complete audit record for a governed action.\n\n# Contents - System identifiers (build hashes) - Replay scope and build environment - Compile-time SCG contract provenance - Provenance source declarations - Tick - Energy snapshot - Reasoning signature - Learning audit (status, hashes, scarcity streak) - Governance artifact binding - Ordered execution trace - Policy snapshot (hash, evaluated rules, decision, reason codes) - Permits/budgets if used - Checksum over the packet",
  "properties": {
    "checksum": {
      "description": "SHA-256 checksum of packet (excluding this field)",
      "type": "string"
    },
    "contract_provenance": {
      "allOf": [
        {
          "$ref": "#/definitions/ContractProvenance"
        }
      ],
      "description": "Contract-critical bridge provenance exported by build.rs."
    },
    "economics_hash": {
      "description": "Economics config hash",
      "type": "string"
    },
    "energy": {
      "allOf": [
        {
          "$ref": "#/definitions/EnergyEnvelope"
        }
      ],
      "description": "Energy snapshot"
    },
    "evaluated_rules": {
      "description": "Evaluated rule IDs (ordered)",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "execution_trace": {
      "description": "Ordered evaluation trace. Empty when no trace has been attached.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "governance_hash": {
      "description": "Canonical governance hash bound to this packet, if available.",
      "type": [
        "string",
        "null"
      ]
    },
    "iter_build_hash": {
      "description": "Iter build hash (compile-time)",
      "type": "string"
    },
    "learning": {
      "allOf": [
        {
          "$ref": "#/definitions/LearningEnvelope"
        }
      ],
      "description": "Learning audit"
    },
    "permit_hash": {
      "description": "Active permit hash (if any)",
      "type": [
        "string",
        "null"
      ]
    },
    "policy": {
      "allOf": [
        {
          "$ref": "#/definitions/PolicyEnvelope"
        }
      ],
      "description": "Policy snapshot"
    },
    "provenance_source": {
      "allOf": [
        {
          "$ref": "#/definitions/ProvenanceSource"
        }
      ],
      "description": "Source declarations for static and dynamic packet values."
    },
    "reasoning": {
      "allOf": [
        {
          "$ref": "#/definitions/ReasoningEnvelope"
        }
      ],
      "description": "Reasoning signature"
    },
    "replay_scope": {
      "allOf": [
        {
          "$ref": "#/definitions/ReplayScope"
        }
      ],
      "description": "Replay scope and build environment for this packet."
    },
    "substrate_build_hash": {
      "description": "SCG build hash (from contract)",
      "type": "string"
    },
    "tick": {
      "description": "Decision tick",
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "required": [
    "checksum",
    "contract_provenance",
    "economics_hash",
    "energy",
    "evaluated_rules",
    "iter_build_hash",
    "learning",
    "policy",
    "provenance_source",
    "reasoning",
    "replay_scope",
    "substrate_build_hash",
    "tick"
  ],
  "title": "DecisionPacket",
  "type": "object"
}