  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "eslint": "10.11.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "8.70.1"
  },
  "overrides": {
    "@babel/core": "7.29.6",
    "brace-expansion@<2": "1.1.18",
    "js-yaml": "3.15.2",
    "minimatch@<4": "3.1.5",
    "picomatch@<3": "2.3.2",
